{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmitOnError": true,
    "outDir": "../../node_modules/.aot/out",
    "rootDir": ".",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "skipLibCheck": true
  },
  "files": ["main.ts"],
  "angularCompilerOptions": {
    "compilationMode": "full",
    "strictTemplates": true,
    "strictInjectionParameters": true
  }
}
