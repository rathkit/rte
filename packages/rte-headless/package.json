{
  "name": "@rathkit/rte-headless",
  "version": "0.1.0-alpha.0",
  "description": "How a toolbar, menu, dialog or announcement should behave for keyboard and assistive technology, with no markup or CSS of its own.",
  "keywords": [
    "rich-text",
    "editor",
    "wysiwyg",
    "contenteditable",
    "zero-dependencies",
    "typescript",
    "accessibility",
    "headless",
    "aria"
  ],
  "license": "Apache-2.0",
  "homepage": "https://rathkit.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rathkit/rte.git",
    "directory": "packages/rte-headless"
  },
  "bugs": {
    "url": "https://github.com/rathkit/rte/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "files": [
    "dist",
    "NOTICE",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@rathkit/rte-core": ">=0.1.0-alpha.0 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@rathkit/rte-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rathkit/rte-core": "workspace:*"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsc -p tsconfig.build.js.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "rathkit": {
    "budgets": [
      {
        "name": "headless",
        "entry": "dist/index.js",
        "gzipKB": 12
      }
    ]
  }
}
