{
  "name": "@rathkit/rte-ui",
  "version": "0.1.0-alpha.1",
  "description": "The styled editor interface: a toolbar and dialogs on the headless layer, themeable with tokens, presets, icons and messages.",
  "keywords": [
    "rich-text",
    "editor",
    "wysiwyg",
    "contenteditable",
    "zero-dependencies",
    "typescript",
    "toolbar",
    "theming"
  ],
  "license": "Apache-2.0",
  "homepage": "https://rathkit.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rathkit/rte.git",
    "directory": "packages/rte-ui"
  },
  "bugs": {
    "url": "https://github.com/rathkit/rte/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "files": [
    "dist",
    "NOTICE",
    "css",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./standard": {
      "types": "./dist/standard.d.ts",
      "default": "./dist/standard.js"
    },
    "./base.css": "./css/base.css"
  },
  "peerDependencies": {
    "@rathkit/rte-core": ">=0.1.0-alpha.1 <0.2.0",
    "@rathkit/rte-headless": ">=0.1.0-alpha.1 <0.2.0",
    "@rathkit/rte-themes": ">=0.1.0-alpha.1 <0.2.0",
    "@rathkit/rte-icons": ">=0.1.0-alpha.1 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@rathkit/rte-core": {
      "optional": true
    },
    "@rathkit/rte-headless": {
      "optional": true
    },
    "@rathkit/rte-themes": {
      "optional": true
    },
    "@rathkit/rte-icons": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rathkit/rte-core": "workspace:*",
    "@rathkit/rte-headless": "workspace:*",
    "@rathkit/rte-themes": "workspace:*",
    "@rathkit/rte-icons": "workspace:*"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsc -p tsconfig.build.js.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node -e \"process.exit(0)\""
  },
  "rathkit": {
    "budgets": [
      {
        "name": "ui",
        "entry": "dist/index.js",
        "gzipKB": 25
      },
      {
        "name": "ui with default icons",
        "entry": "dist/standard.js",
        "gzipKB": 30
      }
    ]
  }
}
