{
  "name": "@rathkit/rte-element",
  "version": "0.1.0-alpha.1",
  "description": "The editor as a custom element, <rk-editor>, for any page or framework: form-associated, with properties, attributes and events.",
  "keywords": [
    "rich-text",
    "editor",
    "wysiwyg",
    "contenteditable",
    "zero-dependencies",
    "typescript",
    "web-components",
    "custom-element"
  ],
  "license": "Apache-2.0",
  "homepage": "https://rathkit.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rathkit/rte.git",
    "directory": "packages/rte-element"
  },
  "bugs": {
    "url": "https://github.com/rathkit/rte/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/define.js"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "files": [
    "dist",
    "NOTICE",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    }
  },
  "peerDependencies": {
    "@rathkit/rte-core": ">=0.1.0-alpha.1 <0.2.0",
    "@rathkit/rte-headless": ">=0.1.0-alpha.1 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@rathkit/rte-core": {
      "optional": true
    },
    "@rathkit/rte-headless": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rathkit/rte-core": "workspace:*",
    "@rathkit/rte-headless": "workspace:*"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsc -p tsconfig.build.js.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node -e \"process.exit(0)\""
  },
  "rathkit": {
    "budgets": [
      {
        "name": "element",
        "entry": "dist/index.js",
        "gzipKB": 4
      }
    ]
  }
}
