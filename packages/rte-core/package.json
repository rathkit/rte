{
  "name": "@rathkit/rte-core",
  "version": "0.1.0-alpha.0",
  "description": "Document model, transforms, commands, view layer and plugin API for Rathkit RTE.",
  "keywords": [
    "rich-text",
    "editor",
    "wysiwyg",
    "contenteditable",
    "zero-dependencies",
    "typescript",
    "document-model",
    "plugins",
    "tables",
    "lists"
  ],
  "license": "Apache-2.0",
  "homepage": "https://rathkit.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rathkit/rte.git",
    "directory": "packages/rte-core"
  },
  "bugs": {
    "url": "https://github.com/rathkit/rte/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "files": [
    "dist",
    "NOTICE",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "default": "./dist/dom/index.js"
    },
    "./lists": {
      "types": "./dist/lists/index.d.ts",
      "default": "./dist/lists/index.js"
    },
    "./tables": {
      "types": "./dist/tables/index.d.ts",
      "default": "./dist/tables/index.js"
    },
    "./autoformat": {
      "types": "./dist/autoformat/index.d.ts",
      "default": "./dist/autoformat/index.js"
    },
    "./find": {
      "types": "./dist/find/index.d.ts",
      "default": "./dist/find/index.js"
    },
    "./word": {
      "types": "./dist/word/index.d.ts",
      "default": "./dist/word/index.js"
    },
    "./svg": {
      "types": "./dist/svg/index.d.ts",
      "default": "./dist/svg/index.js"
    },
    "./images": {
      "types": "./dist/images/index.d.ts",
      "default": "./dist/images/index.js"
    },
    "./standard": {
      "types": "./dist/standard/index.d.ts",
      "default": "./dist/standard/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsc -p tsconfig.build.js.json",
    "typecheck": "tsc -p tsconfig.model.json && tsc -p tsconfig.json --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "rathkit": {
    "plugins": [
      "lists",
      "tables",
      "find",
      "autoformat",
      "word",
      "svg",
      "images"
    ],
    "standard": [
      "standard"
    ],
    "budgets": [
      {
        "name": "core",
        "entry": "dist/index.js",
        "gzipKB": 60
      },
      {
        "name": "core + browser view",
        "entry": "dist/dom/index.js",
        "gzipKB": 60
      },
      {
        "name": "lists plugin",
        "entry": "dist/lists/index.js",
        "gzipKB": 15,
        "plugin": true
      },
      {
        "name": "tables plugin",
        "entry": "dist/tables/index.js",
        "gzipKB": 15,
        "plugin": true
      },
      {
        "name": "autoformat plugin",
        "entry": "dist/autoformat/index.js",
        "gzipKB": 15,
        "plugin": true
      },
      {
        "name": "find plugin",
        "entry": "dist/find/index.js",
        "gzipKB": 15,
        "plugin": true
      },
      {
        "name": "word plugin",
        "entry": "dist/word/index.js",
        "gzipKB": 15,
        "plugin": true
      },
      {
        "name": "svg plugin",
        "entry": "dist/svg/index.js",
        "gzipKB": 15,
        "plugin": true
      },
      {
        "name": "images plugin",
        "entry": "dist/images/index.js",
        "gzipKB": 15,
        "plugin": true
      }
    ]
  }
}
