{
  "name": "@rathkit/rte-icons",
  "version": "0.1.0-alpha.2",
  "description": "The icons the editor interface uses, one SVG string each.",
  "keywords": [
    "rich-text",
    "editor",
    "wysiwyg",
    "contenteditable",
    "zero-dependencies",
    "typescript",
    "icons",
    "svg"
  ],
  "license": "Apache-2.0",
  "homepage": "https://rathkit.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rathkit/rte.git",
    "directory": "packages/rte-icons"
  },
  "bugs": {
    "url": "https://github.com/rathkit/rte/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "files": [
    "dist",
    "NOTICE",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsc -p tsconfig.build.js.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "rathkit": {
    "budgets": [
      {
        "name": "all icons",
        "entry": "dist/index.js",
        "gzipKB": 6
      }
    ]
  }
}
