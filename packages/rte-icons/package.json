{
  "name": "@rathkit/rte-icons",
  "version": "0.0.0",
  "private": true,
  "description": "The icons the editor interface uses, one SVG string each.",
  "license": "Apache-2.0",
  "homepage": "https://rathkit.com",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsc -p tsconfig.build.js.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "rathkit": {
    "budgets": [
      {
        "name": "all icons",
        "entry": "dist/index.js",
        "gzipKB": 6
      }
    ]
  }
}
