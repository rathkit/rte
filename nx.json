{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/tsconfig.base.json"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.ts"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true
    },
    "typecheck": {
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true,
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/fixtures/**/*",
        "{workspaceRoot}/docs/CONTENT-POLICY.md"
      ],
      "cache": true,
      "dependsOn": [
        "^build"
      ]
    }
  },
  "release": {
    "projects": [
      "packages/*"
    ],
    "projectsRelationship": "fixed",
    "releaseTag": {
      "pattern": "v{version}"
    },
    "version": {
      "versionActions": "./tools/release/version-actions.cjs",
      "currentVersionResolver": "git-tag",
      "updateDependents": "auto",
      "specifierSource": "conventional-commits",
      "fallbackCurrentVersionResolver": "disk",
      "adjustSemverBumpsForZeroMajorVersion": false
    },
    "conventionalCommits": {
      "types": {
        "feat": {
          "semverBump": "minor",
          "changelog": {
            "title": "Features"
          }
        },
        "fix": {
          "semverBump": "patch",
          "changelog": {
            "title": "Fixes"
          }
        },
        "perf": {
          "semverBump": "patch",
          "changelog": {
            "title": "Speed"
          }
        },
        "refactor": {
          "semverBump": "patch",
          "changelog": {
            "title": "Internal changes"
          }
        },
        "docs": {
          "semverBump": "patch",
          "changelog": {
            "title": "Documentation"
          }
        },
        "test": {
          "semverBump": "patch",
          "changelog": {
            "title": "Tests"
          }
        },
        "build": {
          "semverBump": "patch",
          "changelog": {
            "title": "Build"
          }
        },
        "ci": {
          "semverBump": "patch",
          "changelog": {
            "title": "Continuous integration"
          }
        },
        "chore": {
          "semverBump": "patch",
          "changelog": {
            "title": "Chores"
          }
        },
        "style": {
          "semverBump": "patch",
          "changelog": {
            "title": "Style"
          }
        },
        "revert": {
          "semverBump": "patch",
          "changelog": {
            "title": "Reverts"
          }
        }
      },
      "useCommitScope": false
    },
    "changelog": {
      "workspaceChangelog": {
        "file": "CHANGELOG.md",
        "createRelease": false,
        "renderOptions": {
          "authors": false
        }
      },
      "projectChangelogs": false,
      "automaticFromRef": true
    },
    "git": {
      "commit": true,
      "tag": true,
      "push": false,
      "commitMessage": "chore(release): {version}",
      "commitArgs": ["--signoff"],
      "tagArgs": ["--sign"]
    }
  }
}
