{
  "name": "rte",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "check:zero-deps": "node tools/check-zero-deps.mjs",
    "check:denylist": "node tools/check-denylist.mjs",
    "check:fixtures": "node tools/check-fixtures.mjs",
    "test:tools": "node --test \"tools/**/*.test.mjs\"",
    "check": "pnpm check:zero-deps && pnpm check:graph && pnpm check:fixtures && pnpm test:tools && pnpm typecheck && pnpm test",
    "check:size": "node tools/check-size.mjs",
    "check:exports": "node tools/check-exports.mjs",
    "check:graph": "node tools/check-graph.mjs",
    "check:packages": "node tools/check-packages.mjs",
    "check:release": "node tools/check-release.mjs",
    "sbom": "node tools/make-sbom.mjs sbom",
    "check:secrets": "node tools/scan-secrets.mjs",
    "check:history": "node tools/scan-secrets.mjs --history && node tools/check-denylist.mjs --history",
    "release:dry": "nx release --skip-publish --dry-run",
    "release": "nx release --skip-publish",
    "bench": "tools/bench/run.sh",
    "bench:quick": "tools/bench/run.sh --quick"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "nx": "23.3.0",
    "typescript": "7.0.2"
  }
}
